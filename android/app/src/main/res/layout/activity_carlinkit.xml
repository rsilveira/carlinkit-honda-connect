<?xml version="1.0" encoding="utf-8"?>
<!-- Carlinkit mode screen: the SurfaceView receives the H.264 video decoded by OMX.
     The status TextView is the only feedback visible on the head unit (no adb). -->
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <SurfaceView
        android:id="@+id/carlinkitSurface"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <TextView
        android:id="@+id/carlinkitStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        android:text="" />

</RelativeLayout>
